apiVersion: v1
kind: Secret
metadata:
  name: example-creds
  namespace: crossplane-system
type: Opaque
stringData:
  # The keys below mirror the arguments of the catonetworks/cato Terraform
  # provider. "token" is a Cato Management Application API key and "account_id"
  # the CMA account it belongs to; both are required. Optional extras: baseurl,
  # retry_max, retry_wait_max_seconds, retry_wait_min_seconds.
  credentials: |
    {
      "token": "1234567-abcd-...",
      "account_id": "12345"
    }
